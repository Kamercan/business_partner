# ───────────────────────────────────────────────────────────────────────────
#  Piyasa & Maliyet Göstergeleri — ortam değişkenleri
#  Bu dosyayı `.env` olarak kopyalayın ve elinizdeki anahtarları doldurun.
#  HİÇBİR anahtar zorunlu değildir; anahtarsız da çalışır (bkz. README).
# ───────────────────────────────────────────────────────────────────────────

PORT=4100
DATA_DIR=./data

# Açılışta verisi olmayan serileri çekmeyi dene
AUTO_INGEST_ON_BOOT=true
# Kaç dakikada bir otomatik güncelleme yapılsın (0 = kapalı)
REFRESH_MINUTES=360
HTTP_TIMEOUT_MS=30000

# ── TCMB EVDS — Türkiye TÜFE / Yİ-ÜFE ──────────────────────────────────────
# Ücretsiz. https://evds2.tcmb.gov.tr → kayıt/giriş → Profil → API Anahtarı
EVDS_API_KEY=

# ── FRED — BLS, EIA ve IMF serilerinin aynası ──────────────────────────────
# İSTEĞE BAĞLI: anahtar yoksa uygulama FRED'in açık CSV ucunu kullanır.
# Anahtar daha yüksek istek limiti sağlar. https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# ── EIA — ABD enerji verisi (Brent, Henry Hub) ─────────────────────────────
# İSTEĞE BAĞLI: bu seriler varsayılan olarak FRED üzerinden gelir.
# https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# ── EPİAŞ Şeffaflık Platformu — Türkiye elektrik PTF ───────────────────────
# Ücretsiz kayıt gerekir. https://kayit.epias.com.tr/
EPIAS_USERNAME=
EPIAS_PASSWORD=

# ── Yazma uçlarını koruma ──────────────────────────────────────────────────
# Boş bırakılırsa yerel/kurum içi kullanım varsayılır ve koruma uygulanmaz.
# Uygulamayı internete açıyorsanız MUTLAKA doldurun; yazma istekleri
# X-Admin-Token başlığıyla gelir.
ADMIN_TOKEN=
