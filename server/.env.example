# ---- Sunucu ----
PORT=4000
NODE_ENV=development
# Tarayıcı istemcisi için izin verilen origin'ler (virgülle).
# Üretimde arayüz aynı sunucudan servis edildiği için genelde gerekmez.
CORS_ORIGIN=http://localhost:5173
# Portalın genel adresi — e-postalardaki takip/yükleme bağlantılarında kullanılır.
# Railway'de RAILWAY_PUBLIC_DOMAIN üzerinden otomatik algılanır.
PUBLIC_BASE_URL=http://localhost:5173

# ---- Güvenlik ----
# Üretimde en az 32 karakter olmalıdır. Boş bırakılırsa üretimde güçlü bir
# anahtar üretilip kalıcı diske yazılır (DATA_DIR/.jwt-secret).
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
JWT_EXPIRES_IN=8h

# ---- Kalıcı veri ----
# Veritabanı ve yüklenen belgeler bu dizinde tutulur.
# Docker/Railway'de kalıcı disk buraya bağlanır (örn. /data).
DATA_DIR=./data
# İsterseniz tek tek de belirtebilirsiniz (DATA_DIR'i geçersiz kılar):
# DB_FILE=./data/portal.db
# STORAGE_DIR=./storage
MAX_UPLOAD_MB=20

# ---- İlk kurulum ----
# Demo modu: örnek başvurular, tedarikçiler ve rol hesapları oluşturulur,
# giriş ekranında demo hesapları gösterilir. Gerçek kullanımda false yapın.
SEED_DEMO=true
SEED_ADMIN_EMAIL=admin@yanmar.com.tr
# Boş bırakılırsa: geliştirmede Admin123!, üretimde rastgele güçlü bir parola
# üretilir ve ilk açılış loglarında bir kez gösterilir.
SEED_ADMIN_PASSWORD=

# ---- E-posta (opsiyonel) ----
# SMTP_HOST boşsa her bildirim yalnızca mail_outbox tablosuna yazılır ve
# yönetim panelindeki "E-posta Kutusu" ekranından görüntülenir.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Yanmar Türkiye Business Partner <no-reply@yanmar.com.tr>"
# Yeni başvuru geldiğinde haberdar edilecek iç adresler (virgülle)
NOTIFY_EMAILS=satinalma@yanmar.com.tr
