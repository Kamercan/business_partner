# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma separated list of allowed origins for the browser client
CORS_ORIGIN=http://localhost:5173
# Public base URL of the portal (used in e-mails / tracking links)
PUBLIC_BASE_URL=http://localhost:5173

# ---- Security ----
# CHANGE THIS IN PRODUCTION. Must be at least 32 characters.
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
JWT_EXPIRES_IN=8h

# ---- Storage ----
DB_FILE=./data/portal.db
STORAGE_DIR=./storage
MAX_UPLOAD_MB=20

# ---- Seed admin (created by `npm run db:seed`) ----
SEED_ADMIN_EMAIL=admin@yanmar.com.tr
SEED_ADMIN_PASSWORD=Admin123!

# ---- E-mail (optional) ----
# When SMTP_HOST is empty every message is only written to the mail outbox table
# and is visible in the admin panel (Bildirimler > E-posta Kutusu).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Yanmar Türkiye Business Partner <no-reply@yanmar.com.tr>"
# Internal recipients notified when a new application arrives
NOTIFY_EMAILS=satinalma@yanmar.com.tr
